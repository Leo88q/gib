# Режим и хранилище (в продакшене обязателен GIB_STORE=postgres)
NODE_ENV=production
GIB_STORE=postgres
GIB_RATE_LIMIT_STORE=postgres
POSTGRES_USER=gib
POSTGRES_PASSWORD=replace_with_strong_random_db_password
POSTGRES_DB=gib
GIB_POSTGRES_URL=postgresql://gib:replace_with_strong_random_db_password@postgres:5432/gib
GIB_PG_BUFFER_MB=64
GIB_PG_POOL_MAX=20

# Реквизиты оператора персональных данных и оферты (обязательны для открытия production API)
GIB_OPERATOR_NAME=
GIB_OPERATOR_REGISTRATION=
GIB_OPERATOR_ADDRESS=
GIB_OPERATOR_EMAIL=

# Публичный HTTPS-адрес приложения (для кнопок Mini App и ссылок в ботах)
GIB_PUBLIC_URL=https://gib.example.ru

# Секрет серверных HttpOnly-сессий и ворот кабинета родителя (>= 32 символов)
GIB_SESSION_SECRET=replace_with_64_hex_chars_from_openssl_rand_hex_32

# Telegram Mini App и вебхук бота (/api/telegram/webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# MAX Mini App и вебхук бота (/api/max/webhook)
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=

# Почтовый вебхук для одноразовых кодов входа в браузере и уведомлений (необязательно)
GIB_EMAIL_WEBHOOK_URL=
GIB_EMAIL_WEBHOOK_SECRET=

# Платёжный шлюз ЮKassa и фискальные чеки 54-ФЗ
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://gib.example.ru/parent
# Код ставки НДС для чека 54-ФЗ (1 = без НДС, 2 = 0%, 3 = 10%, 4 = 20%, 5 = 10/110, 6 = 20/120)
GIB_RECEIPT_VAT_CODE=1

# Секреты эксплуатации, резервных копий, планировщика, воронки и мониторинга
CRON_SECRET=replace_with_random_cron_secret
GIB_BACKUP_KEY_HEX=
BACKUP_INTERVAL_SEC=86400
BACKUP_RETENTION_COUNT=14
GIB_METRICS_TOKEN=
GIB_ADMIN_TOKEN=
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password

# Yandex AI Studio (грантовый бюджет; ключи только в окружении/Lockbox)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=b1g4u6puplb11nlqbjlg
# Необязательно: голос SpeechKit (по умолчанию alena), размер и модель арта/LLM
YANDEX_TTS_VOICE=alena
YANDEX_ART_BASE=https://ai.api.cloud.yandex.net/v1
YANDEX_ART_MODEL=art://b1g4u6puplb11nlqbjlg/aliceai-image-art-3.0/latest
YANDEX_LLM_MODEL=gpt://b1g4u6puplb11nlqbjlg/aliceai-llm-flash
