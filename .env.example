# Режим и хранилище (в продакшене обязателен GIB_STORE=postgres)
NODE_ENV=production
GIB_STORE=postgres
GIB_RATE_LIMIT_STORE=postgres
POSTGRES_USER=gib
POSTGRES_PASSWORD=replace_with_strong_random_db_password
POSTGRES_DB=gib
GIB_POSTGRES_URL=postgresql://gib:replace_with_strong_random_db_password@postgres:5432/gib
GIB_PG_BUFFER_MB=64

# Публичный HTTPS-адрес приложения (для кнопок Mini App и ссылок в ботах)
GIB_PUBLIC_URL=https://gib.example.ru

# Секрет серверных HttpOnly-сессий и ворот кабинета родителя (>= 32 символов)
GIB_SESSION_SECRET=replace_with_64_hex_chars_from_openssl_rand_hex_32

# Telegram Mini App и вебхук бота (/api/telegram/webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# MAX Mini App и вебхук бота (/api/max/webhook)
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=

# Почтовый вебхук для одноразовых кодов входа в браузере и уведомлений (необязательно)
GIB_EMAIL_WEBHOOK_URL=
GIB_EMAIL_WEBHOOK_SECRET=

# Платёжный шлюз ЮKassa и фискальные чеки 54-ФЗ
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://gib.example.ru/parent
# Код ставки НДС для чека 54-ФЗ (1 = без НДС, 2 = 0%, 3 = 10%, 4 = 20%, 5 = 10/110, 6 = 20/120)
GIB_RECEIPT_VAT_CODE=1

# Секреты эксплуатации, резервных копий, планировщика, воронки и метрик
CRON_SECRET=replace_with_random_cron_secret
GIB_BACKUP_KEY_HEX=
GIB_METRICS_TOKEN=
GIB_ADMIN_TOKEN=
