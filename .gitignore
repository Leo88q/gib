node_modules/
.next/
out/
build/
.DS_Store
*.log

# Локальные данные приложения (профили детей, сессии) — в репозиторий не попадают.
# Якорь `/data` обязателен: без него правило глушит любой путь с папкой `data`
# в середине, например `app/api/profile/data/`. Именно так пропал маршрут
# сводки данных профиля: файл лежал на диске, но в git не попадал, и после
# пересборки окружения его не стало, а интерфейс показывал ошибку загрузки.
# Исключаем содержимое /data/, а не сам каталог: так можно точечно вернуть
# производственные не-персональные файлы (постановка/каталог/раскадровки).
# Профили детей и сессии в /data/ по-прежнему вне git.
/data/*
!/data/art-shotlist.json
!/data/frame-catalog.json
!/data/storyboards.json
tsconfig.tsbuildinfo

# Секреты и локальные резервные копии, в том числе за пределами data/
.env
.env.*
!.env.example
*.gib
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
.gib-secure-backup-*/
.gib-secure-restore-*/
.gib-secure-verify-*/
.gib-postgres-import-*/
